# ─────────────────────────────────────────────────────────────
#  Edge Function secrets
#
#  Local:   copy to `supabase/.env` — `supabase functions serve` loads it
#  Hosted:  supabase secrets set --env-file supabase/.env
#
#  SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are
#  injected automatically by the platform — never set them here.
# ─────────────────────────────────────────────────────────────

# Allowed browser origin(s) for CORS (comma separated). Leave blank for "*".
CLIENT_URL=http://localhost:5173

# ─── Payments ────────────────────────────────────────────────

# Razorpay — https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Stripe — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx
# `supabase functions serve` prints this when you run `stripe listen`
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# ─── Notifications (both optional) ───────────────────────────

# Email via Resend — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxx
EMAIL_FROM="Khang Restaurant <orders@khang.com>"

# SMS via Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_PHONE_NUMBER=+1234567890
