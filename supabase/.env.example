# Edge Function secrets — copy to supabase/.env for local function work.
# Never add this file with real values to git.
# SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY are supplied
# automatically in deployed Supabase Edge Functions.

# Comma-separated browser origins. Use exact HTTPS production origins in prod.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Razorpay (required only for UPI / wallet / Razorpay card checkout)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Stripe (optional; only required when using the Stripe intent endpoint)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx
