# ─────────────────────────────────────────────────────────────
# Khang Frontend — Supabase Environment Variables
# Copy this file to `.env.local` (or `.env`) and fill in values from
# Supabase Dashboard → Project Settings → API.
# ─────────────────────────────────────────────────────────────

# Public values only — safe to expose in a Vite browser build.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Do NOT put SUPABASE_SERVICE_ROLE_KEY, Razorpay secrets, or Stripe secrets
# here. Set those only with `supabase secrets set` for the Edge Function.
