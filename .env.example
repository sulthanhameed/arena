# ─────────────────────────────────────────────────
# Khang Frontend — Environment Variables
# Copy this file to `.env` and fill in your values.
# ─────────────────────────────────────────────────

# ─── Supabase ────────────────────────────────────
# Hosted project:  Dashboard → Project Settings → API
# Local stack:     the values printed by `supabase start`
#
# The anon key is PUBLIC by design — every table is protected by Row Level
# Security, so this key on its own only exposes the menu.
# Never put the service_role key in this file: it bypasses RLS and belongs
# in Edge Function secrets only (see supabase/.env.example).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Local development with `supabase start` instead:
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=<the anon key printed by supabase start>

# Leave both blank to run the UI in offline demo mode (static menu,
# simulated checkout, no network calls).
